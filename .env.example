# Copy this file to .env and fill in real values. Never commit .env.

# HuggingFace token for downloading andy279 datasets and the Nemotron base model.
# https://huggingface.co/settings/tokens
# Required scopes: read. ToS acceptance also required on andy279/nemotron-reasoning-challenge
# and andy279/nemotron-reasoning-challenge-raw-traces.
HF_TOKEN=

# DeepSeek API key for Phase 2 teacher CoT generation.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: DeepSeek base URL override (defaults to https://api.deepseek.com)
# Set this to https://openrouter.ai/api/v1 to fall back to OpenRouter.
DEEPSEEK_BASE_URL=

# Optional: Weights & Biases API key for training run tracking.
WANDB_API_KEY=

# Optional: NVIDIA NIM API key, only used as a fallback teacher source.
NIM_API_KEY=
